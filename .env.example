# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Dashboard Supabase -> Settings -> API). Voir SETUP.md pour le pas-à-pas.

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (utilisée par le navigateur, protégée par la RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SERVEUR UNIQUEMENT, ne jamais l'exposer côté client.
# Requise pour les formulaires clients publics (validation de token).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app (ex: https://coach-os.vercel.app). Sert à construire
# les liens dans les emails. En local, laisser vide (http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Emails (Resend) — optionnel, pour l'envoi des liens + rappel hebdo ------
# Clé API Resend (https://resend.com). Sans elle, les boutons "Envoyer par
# email" signalent simplement que l'email n'est pas configuré.
RESEND_API_KEY=
# Expéditeur. Tant que le domaine n'est pas vérifié sur Resend, laisser vide
# (utilise onboarding@resend.dev, qui n'envoie qu'à ta propre adresse Resend).
RESEND_FROM=
# Secret protégeant le cron du rappel hebdo (mettre une valeur aléatoire).
CRON_SECRET=
